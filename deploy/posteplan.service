[Unit]
Description=PostePlan IA (PoC Business Plan)
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/bp-laposte
Environment=URL_PREFIX=/bp-laposte
Environment=PORT=8080
EnvironmentFile=-/var/www/bp-laposte/.env
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
